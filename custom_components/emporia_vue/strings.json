{
  "config": {
    "step": {
      "user": {
        "data": {
          "auth_method": "Authentication method"
        }
      },
      "email_password": {
        "data": {
          "email": "[%key:common::config_flow::data::email%]",
          "password": "[%key:common::config_flow::data::password%]",
          "enable_1m": "Power Minute Average Sensor",
          "enable_1d": "Energy Today Sensor",
          "enable_1mon": "Energy This Month Sensor",
          "enable_amps": "Current Minute Average Sensor",
          "enable_volts": "Line Voltage Sensor",
          "solar_invert": "Invert Values for Solar Circuits",
          "cost_per_kwh": "Cost per kWh",
          "cost_currency": "Cost Currency"
        }
      },
      "tokens": {
        "description": "Use this for Emporia accounts created with Sign in with Google or another SSO provider. Paste the Emporia tokens for the account.",
        "data": {
          "id_token": "ID token",
          "access_token": "Access token",
          "refresh_token": "Refresh token",
          "enable_1m": "[%key:component::emporia_vue::config::step::email_password::data::enable_1m%]",
          "enable_1d": "[%key:component::emporia_vue::config::step::email_password::data::enable_1d%]",
          "enable_1mon": "[%key:component::emporia_vue::config::step::email_password::data::enable_1mon%]",
          "enable_amps": "[%key:component::emporia_vue::config::step::email_password::data::enable_amps%]",
          "enable_volts": "[%key:component::emporia_vue::config::step::email_password::data::enable_volts%]",
          "solar_invert": "[%key:component::emporia_vue::config::step::email_password::data::solar_invert%]",
          "cost_per_kwh": "[%key:component::emporia_vue::config::step::email_password::data::cost_per_kwh%]",
          "cost_currency": "[%key:component::emporia_vue::config::step::email_password::data::cost_currency%]"
        }
      },
      "reconfigure": {
        "data": {
          "enable_1m": "[%key:component::emporia_vue::config::step::email_password::data::enable_1m%]",
          "enable_1d": "[%key:component::emporia_vue::config::step::email_password::data::enable_1d%]",
          "enable_1mon": "[%key:component::emporia_vue::config::step::email_password::data::enable_1mon%]",
          "enable_amps": "[%key:component::emporia_vue::config::step::email_password::data::enable_amps%]",
          "enable_volts": "[%key:component::emporia_vue::config::step::email_password::data::enable_volts%]",
          "solar_invert": "[%key:component::emporia_vue::config::step::email_password::data::solar_invert%]",
          "cost_per_kwh": "[%key:component::emporia_vue::config::step::email_password::data::cost_per_kwh%]",
          "cost_currency": "[%key:component::emporia_vue::config::step::email_password::data::cost_currency%]"
        }
      },
      "reauth_confirm": {
        "title": "[%key:common::config_flow::title::reauth%]",
        "description": "The Emporia Vue integration needs to re-authenticate your account",
        "data": {
          "email": "[%key:common::config_flow::data::email%]",
          "password": "[%key:common::config_flow::data::password%]",
          "id_token": "[%key:component::emporia_vue::config::step::tokens::data::id_token%]",
          "access_token": "[%key:component::emporia_vue::config::step::tokens::data::access_token%]",
          "refresh_token": "[%key:component::emporia_vue::config::step::tokens::data::refresh_token%]"
        }
      }
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]",
      "reauth_successful": "[%key:common::config_flow::abort::reauth_successful%]",
      "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]"
    }
  },
  "entity": {
    "number": {
      "charge_current_limit": {
        "name": "Current Limit"
      }
    },
    "sensor": {
      "charger_status": {
        "name": "Status"
      }
    }
  },
  "services": {
    "set_charger_current": {
      "name": "Set charger current",
      "description": "Sets the charging current for an EVSE/charger",
      "fields": {
        "current": {
          "name": "Charging current",
          "description": "The desired charging current in amps"
        }
      }
    }
  }
}
